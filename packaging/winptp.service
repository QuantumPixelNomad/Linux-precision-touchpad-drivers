[Unit]
Description=Windows Precision Touchpad behaviour (winptp)
After=systemd-udev-settle.service
ConditionPathExists=/opt/winptp/winptp/daemon.py

[Service]
Type=simple
Environment=PYTHONPATH=/opt/winptp
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/sbin/modprobe uinput
ExecStart=/usr/bin/python3 -I -m winptp -c /etc/winptp/winptp.toml
Restart=always
RestartSec=1
Nice=-10

[Install]
WantedBy=multi-user.target
